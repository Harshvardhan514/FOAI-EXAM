{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/iss/(.*)", "destination": "http://api.open-notify.org/$1" },
    { "source": "/api/geo/(.*)", "destination": "https://nominatim.openstreetmap.org/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
